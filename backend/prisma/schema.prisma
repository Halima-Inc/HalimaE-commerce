enum OUTBOXSTATUS {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

model OutboxEvent {
  id             String      @id @default(uuid()) @db.Uuid
  eventId        String      @unique
  eventName      String
  aggregateId    String
  providerRef    String
  idempotencyKey String
  version        Int
  occurredAt     DateTime
  payload        Json
  status         OUTBOXSTATUS @default(PENDING)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?     @db.Text
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([idempotencyKey])
  @@index([eventName, status])
  @@map("outbox_events")
}

model DashboardRevenueSnapshot {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  revenue   Decimal  @db.Decimal(12, 2) @default(0)
  orders    Int      @default(0)
  itemsSold Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("dashboard_revenue_snapshots")
}

model OrdersByStatus {
  id        Int       @id @default(autoincrement())
  status    ORDERSTATUS
  date      DateTime
  count     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([status, date])
  @@index([date])
  @@map("dashboard_orders_by_status")
}

model BestSellingProduct {
  id          Int      @id @default(autoincrement())
  productId   String   @db.Uuid
  periodStart DateTime
  periodEnd   DateTime
  qtySold     Int      @default(0)
  revenue     Decimal  @db.Decimal(12, 2) @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([productId, periodStart])
  @@map("dashboard_best_selling_products")
}

model LowStockProduct {
  id                 Int      @id @default(autoincrement())
  variantId          String   @db.Uuid @unique
  productId          String   @db.Uuid
  stockOnHand        Int
  lowStockThreshold  Int
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("dashboard_low_stock_products")
}

model OrdersByLocation {
  id        Int      @id @default(autoincrement())
  location  String
  date      DateTime
  count     Int      @default(0)
  revenue   Decimal  @db.Decimal(12, 2) @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([location, date])
  @@map("dashboard_orders_by_location")
}

model OrderStatistics {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  intValue  Int?
  decValue  Decimal? @db.Decimal(12, 2)
  jsonValue Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("dashboard_order_statistics")
}

model CustomerCounters {
  id         Int      @id @default(autoincrement())
  customerId String   @db.Uuid @unique
  orders     Int      @default(0)
  lifetimeValue Decimal @db.Decimal(12,2) @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("dashboard_customer_counters")
}

model ProductsByCategory {
  id          Int      @id @default(autoincrement())
  categoryId  String   @db.Uuid
  periodStart DateTime
  periodEnd   DateTime
  qtySold     Int      @default(0)
  revenue     Decimal  @db.Decimal(12, 2) @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([categoryId, periodStart])
  @@map("dashboard_products_by_category")
}
